doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title
    style.
      body {
        font-family: Arial, sans-serif;
        margin: 40px;
        background-color: #f4f4f4;
      }

      .container {
        max-width: 900px;
        margin: auto;
        background: white;
        padding: 25px;
        border-radius: 10px;
      }

      h1 {
        color: #333;
      }

      a {
        color: #007bff;
        text-decoration: none;
      }

      .todo {
        border: 1px solid #ddd;
        padding: 15px;
        margin-bottom: 10px;
        border-radius: 8px;
        background: #fafafa;
      }

      .completed {
        color: green;
        font-weight: bold;
      }

      .pending {
        color: orange;
        font-weight: bold;
      }

  body
    .container
      block content